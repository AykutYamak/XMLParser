7216 {\cf18 void} ConsoleReporter::test_case_exception({\cf17 const} TestCaseException &e) \{\par
7217     DOCTEST_LOCK_MUTEX(mutex)\par
7218     {\cf19 if} (tc->m_no_output)\par
7219         {\cf19 return};\par
7220 \par
7221     logTestStart();\par
7222 \par
7223     file_line_to_stream(tc->m_file.c_str(), {\cf17 static_cast<}{\cf18 int}{\cf17 >}(tc->m_line), {\cf22 " "});\par
7224     successOrFailColoredStringToStream({\cf17 false}, e.is_crash ? assertType::is_require : assertType::is_check);\par
7225     s << Color::Red << (e.is_crash ? {\cf22 "test case CRASHED: "} : {\cf22 "test case THREW exception: "});\par
7226     s << Color::Cyan << e.error_string << {\cf22 "\\n"};\par
7227 \par
7228     {\cf17 const} {\cf18 int} num_stringified_contexts = get_num_stringified_contexts();\par
7229     {\cf19 if} (num_stringified_contexts) \{\par
7230         {\cf17 auto} stringified_contexts = get_stringified_contexts();\par
7231         s << Color::None << {\cf22 "  logged: "};\par
7232         {\cf19 for} ({\cf18 int} i = num_stringified_contexts; i > 0; --i) \{\par
7233             s << (i == num_stringified_contexts ? {\cf22 ""} : {\cf22 "          "}) << stringified_contexts[i - 1] << {\cf22 "\\n"};\par
7234         \}\par
7235     \}\par
7236     s << {\cf22 "\\n"} << Color::None;\par
7237 \}\par
