7246 {\cf18 void} ConsoleReporter::subcase_end() \{\par
7247     DOCTEST_LOCK_MUTEX(mutex)\par
7248     --currentSubcaseLevel;\par
7249     hasLoggedCurrentTestStart = {\cf17 false};\par
7250 \}\par
