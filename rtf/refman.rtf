7167 {\cf18 void} ConsoleReporter::test_case_start({\cf17 const} TestCaseData &in) \{\par
7168     DOCTEST_LOCK_MUTEX(mutex)\par
7169     hasLoggedCurrentTestStart = {\cf17 false};\par
7170     tc = &in;\par
7171     subcasesStack.clear();\par
7172     currentSubcaseLevel = 0;\par
7173 \}\par
