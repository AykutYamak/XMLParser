7429 {\cf18 void} JUnitReporter::test_run_end({\cf17 const} TestRunStats &p) \{\par
7430     {\cf20 // remove .exe extension - mainly to have the same output on UNIX and Windows}\par
7431     {\cf20 // NOLINTNEXTLINE(misc-const-correctness)}\par
7432     std::string binary_name = skipPathFromFilename(opt.binary_name.c_str());\par
7433 {\cf21 #ifdef DOCTEST_PLATFORM_WINDOWS}\par
7434     {\cf19 if} (binary_name.rfind({\cf22 ".exe"}) != std::string::npos)\par
7435         binary_name = binary_name.substr(0, binary_name.length() - 4);\par
7436 {\cf21 #endif }{\cf20 // DOCTEST_PLATFORM_WINDOWS}\par
7437 \par
7438     xml.startElement({\cf22 "testsuites"});\par
7439     xml.startElement({\cf22 "testsuite"})\par
7440         .writeAttribute({\cf22 "name"}, binary_name)\par
7441         .writeAttribute({\cf22 "errors"}, testCaseData.totalErrors)\par
7442         .writeAttribute({\cf22 "failures"}, testCaseData.totalFailures)\par
7443         .writeAttribute({\cf22 "tests"}, p.numAsserts);\par
7444     {\cf19 if} (opt.no_time_in_output == {\cf17 false}) \{\par
7445         xml.writeAttribute({\cf22 "time"}, testCaseData.totalSeconds);\par
7446         xml.writeAttribute({\cf22 "timestamp"}, JUnitTestCaseData::getCurrentTimestamp());\par
7447     \}\par
7448     {\cf19 if} (opt.no_version == {\cf17 false})\par
7449         xml.writeAttribute({\cf22 "doctest_version"}, DOCTEST_VERSION_STR);\par
7450 \par
7451     {\cf19 for} ({\cf17 const} {\cf17 auto} &testCase: testCaseData.testcases) \{\par
7452         xml.startElement({\cf22 "testcase"})\par
7453             .writeAttribute({\cf22 "classname"}, testCase.classname)\par
7454             .writeAttribute({\cf22 "name"}, testCase.name);\par
7455         {\cf19 if} (opt.no_time_in_output == {\cf17 false})\par
7456             xml.writeAttribute({\cf22 "time"}, testCase.time);\par
7457         {\cf20 // This is not ideal, but it should be enough to mimic gtest's junit output.}\par
7458         xml.writeAttribute({\cf22 "status"}, {\cf22 "run"});\par
7459 \par
7460         {\cf19 for} ({\cf17 const} {\cf17 auto} &failure: testCase.failures) \{\par
7461             xml.scopedElement({\cf22 "failure"})\par
7462                 .writeAttribute({\cf22 "message"}, failure.message)\par
7463                 .writeAttribute({\cf22 "type"}, failure.type)\par
7464                 .writeText(failure.details, {\cf17 false});\par
7465         \}\par
7466 \par
7467         {\cf19 for} ({\cf17 const} {\cf17 auto} &error: testCase.errors) \{\par
7468             xml.scopedElement({\cf22 "error"}).writeAttribute({\cf22 "message"}, error.message).writeText(error.details);\par
7469         \}\par
7470 \par
7471         xml.endElement();\par
7472     \}\par
7473     xml.endElement();\par
7474     xml.endElement();\par
7475 \}\par
