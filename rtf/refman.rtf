6461         {\cf19 if} (*wild == {\cf23 '*'}) \{\par
6462             {\cf19 if} (!*++wild) \{\par
6463                 {\cf19 return} 1;\par
6464             \}\par
6465             mp = wild;\par
6466             cp = str + 1;\par
6467         \} {\cf19 else} {\cf19 if} ((caseSensitive ? (*wild == *str) : (tolower(*wild) == tolower(*str))) || (*wild == {\cf23 '?'})) \{\par
6468             wild++;\par
