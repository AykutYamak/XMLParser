8875     {\cf18 void} XmlEncode::encodeTo( std::ostream& os ){\cf17  const }\{\par
8876         {\cf20 // Apostrophe escaping not necessary if we always use " to write attributes}\par
8877         {\cf20 // (see: https://www.w3.org/TR/xml/#syntax)}\par
8878 \par
8879         {\cf19 for}( std::size_t idx = 0; idx < m_str.size(); ++ idx ) \{\par
8880             uchar c = m_str[idx];\par
8881             {\cf19 switch} (c) \{\par
8882             {\cf19 case} {\cf23 '<'}:   os << {\cf22 "&lt;"}; {\cf19 break};\par
8883             {\cf19 case} {\cf23 '&'}:   os << {\cf22 "&amp;"}; {\cf19 break};\par
8884 \par
8885             {\cf19 case} {\cf23 '>'}:\par
8886                 {\cf20 // See: https://www.w3.org/TR/xml/#syntax}\par
8887                 {\cf19 if} (idx > 2 && m_str[idx - 1] == {\cf23 ']'} && m_str[idx - 2] == {\cf23 ']'})\par
8888                     os << {\cf22 "&gt;"};\par
8889                 {\cf19 else}\par
8890                     os << c;\par
8891                 {\cf19 break};\par
8892 \par
8893             {\cf19 case} {\cf23 '\\"'}:\par
8894                 {\cf19 if} (m_forWhat == ForAttributes)\par
8895                     os << {\cf22 "&quot;"};\par
8896                 {\cf19 else}\par
8897                     os << c;\par
8898                 {\cf19 break};\par
8899 \par
8900             {\cf19 default}:\par
8901                 {\cf20 // Check for control characters and invalid utf-8}\par
8902 \par
8903                 {\cf20 // Escape control characters in standard ascii}\par
8904                 {\cf20 // see https://stackoverflow.com/questions/404107/why-are-control-characters-illegal-in-xml-1-0}\par
8905                 {\cf19 if} (c < 0x09 || (c > 0x0D && c < 0x20) || c == 0x7F) \{\par
8906                     hexEscapeChar(os, c);\par
8907                     {\cf19 break};\par
8908                 \}\par
8909 \par
8910                 {\cf20 // Plain ASCII: Write it to stream}\par
8911                 {\cf19 if} (c < 0x7F) \{\par
8912                     os << c;\par
8913                     {\cf19 break};\par
8914                 \}\par
8915 \par
8916                 {\cf20 // UTF-8 territory}\par
8917                 {\cf20 // Check if the encoding is valid and if it is not, hex escape bytes.}\par
8918                 {\cf20 // Important: We do not check the exact decoded values for validity, only the encoding format}\par
8919                 {\cf20 // First check that this bytes is a valid lead byte:}\par
8920                 {\cf20 // This means that it is not encoded as 1111 1XXX}\par
8921                 {\cf20 // Or as 10XX XXXX}\par
8922                 {\cf19 if} (c <  0xC0 ||\par
8923                     c >= 0xF8) \{\par
8924                     hexEscapeChar(os, c);\par
8925                     {\cf19 break};\par
8926                 \}\par
8927 \par
8928                 {\cf17 auto} encBytes = trailingBytes(c);\par
8929                 {\cf20 // Are there enough bytes left to avoid accessing out-of-bounds memory?}\par
8930                 {\cf19 if} (idx + encBytes - 1 >= m_str.size()) \{\par
8931                     hexEscapeChar(os, c);\par
8932                     {\cf19 break};\par
8933                 \}\par
8934                 {\cf20 // The header is valid, check data}\par
8935                 {\cf20 // The next encBytes bytes must together be a valid utf-8}\par
8936                 {\cf20 // This means: bitpattern 10XX XXXX and the extracted value is sane (ish)}\par
8937                 {\cf18 bool} valid = {\cf17 true};\par
8938                 uint32_t value = headerValue(c);\par
8939                 {\cf19 for} (std::size_t n = 1; n < encBytes; ++n) \{\par
8940                     uchar nc = m_str[idx + n];\par
8941                     valid &= ((nc & 0xC0) == 0x80);\par
8942                     value = (value << 6) | (nc & 0x3F);\par
8943                 \}\par
8944 \par
8945                 {\cf19 if} (\par
8946                     {\cf20 // Wrong bit pattern of following bytes}\par
8947                     (!valid) ||\par
8948                     {\cf20 // Overlong encodings}\par
8949                     (value < 0x80) ||\par
8950                     (                 value < 0x800   && encBytes > 2) || {\cf20 // removed "0x80 <= value &&" because redundant}\par
8951                     (0x800 < value && value < 0x10000 && encBytes > 3) ||\par
8952                     {\cf20 // Encoded value out of range}\par
8953                     (value >= 0x110000)\par
8954                     ) \{\par
8955                     hexEscapeChar(os, c);\par
8956                     {\cf19 break};\par
8957                 \}\par
8958 \par
8959                 {\cf20 // If we got here, this is in fact a valid(ish) utf-8 sequence}\par
8960                 {\cf19 for} (std::size_t n = 0; n < encBytes; ++n) \{\par
8961                     os << m_str[idx + n];\par
8962                 \}\par
8963                 idx += encBytes - 1;\par
8964                 {\cf19 break};\par
8965             \}\par
8966         \}\par
8967     \}\par
