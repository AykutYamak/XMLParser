5503 {\cf20 // the implementation of parseOption()}\par
5504 {\cf18 bool} parseOptionImpl({\cf18 int} argc, {\cf17 const} {\cf18 char} *{\cf17 const} *argv, {\cf17 const} {\cf18 char} *pattern, String *value) \{\par
5505     {\cf20 // going from the end to the beginning and stopping on the first occurrence from the end}\par
5506     {\cf19 for} ({\cf18 int} i = argc; i > 0; --i) \{\par
5507         {\cf17 auto} index = i - 1;\par
5508         {\cf17 auto} temp = std::strstr(argv[index], pattern);\par
5509         {\cf19 if} (temp && (value || strlen(temp) == strlen(pattern))) \{\par
5510             {\cf20 // eliminate matches in which the chars before the option are not '-'}\par
5511             {\cf18 bool} noBadCharsFound = {\cf17 true};\par
5512             {\cf17 auto} curr = argv[index];\par
5513             {\cf19 while} (curr != temp) \{\par
5514                 {\cf19 if} (*curr++ != {\cf23 '-'}) \{\par
5515                     noBadCharsFound = {\cf17 false};\par
5516                     {\cf19 break};\par
5517                 \}\par
5518             \}\par
5519             {\cf19 if} (noBadCharsFound && argv[index][0] == {\cf23 '-'}) \{\par
5520                 {\cf19 if} (value) \{\par
5521                     {\cf20 // parsing the value of an option}\par
5522                     temp += strlen(pattern);\par
5523                     {\cf17 const} {\cf18 unsigned} len = strlen(temp);\par
5524                     {\cf19 if} (len) \{\par
5525                         *value = temp;\par
5526                         {\cf19 return} {\cf17 true};\par
5527                     \}\par
5528                 \} {\cf19 else} \{\par
5529                     {\cf20 // just a flag - no value}\par
5530                     {\cf19 return} {\cf17 true};\par
5531                 \}\par
5532             \}\par
5533         \}\par
5534     \}\par
5535     {\cf19 return} {\cf17 false};\par
5536 \}\par
5537 \par
5538 {\cf20 // parses an option and returns the string after the '=' character}\par
5539 {\cf18 bool} parseOption(\par
5540     {\cf18 int} argc, {\cf17 const} {\cf18 char} *{\cf17 const} *argv, {\cf17 const} {\cf18 char} *pattern, String *value = {\cf17 nullptr}, {\cf17 const} String &defaultVal = String()\par
5541 ) \{\par
5542     {\cf19 if} (value)\par
5543         *value = defaultVal;\par
5544 {\cf21 #ifndef DOCTEST_CONFIG_NO_UNPREFIXED_OPTIONS}\par
5545     {\cf20 // offset (normally 3 for "dt-") to skip prefix}\par
5546     {\cf19 if} (parseOptionImpl(argc, argv, pattern + strlen(DOCTEST_CONFIG_OPTIONS_PREFIX), value))\par
5547         {\cf19 return} {\cf17 true};\par
5548 {\cf21 #endif }{\cf20 // DOCTEST_CONFIG_NO_UNPREFIXED_OPTIONS}\par
5549     {\cf19 return} parseOptionImpl(argc, argv, pattern, value);\par
5550 \}\par
