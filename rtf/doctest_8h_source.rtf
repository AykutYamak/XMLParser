7881 FatalConditionHandler::FatalConditionHandler() \{\par
7882     isSet = {\cf17 true};\par
7883     {\cf20 // 32k seems enough for doctest to handle stack overflow,}\par
7884     {\cf20 // but the value was found experimentally, so there is no strong guarantee}\par
7885     guaranteeSize = 32 * 1024;\par
7886     {\cf20 // Register an unhandled exception filter}\par
7887     previousTop = SetUnhandledExceptionFilter(handleException);\par
7888     {\cf20 // Pass in guarantee size to be filled}\par
7889     SetThreadStackGuarantee(&guaranteeSize);\par
7890 \par
7891     {\cf20 // On Windows uncaught exceptions from another thread, exceptions from}\par
7892     {\cf20 // destructors, or calls to std::terminate are not a SEH exception}\par
7893 \par
7894     {\cf20 // The terminal handler gets called when:}\par
7895     {\cf20 // - std::terminate is called FROM THE TEST RUNNER THREAD}\par
7896     {\cf20 // - an exception is thrown from a destructor FROM THE TEST RUNNER THREAD}\par
7897     original_terminate_handler = std::get_terminate();\par
7898     std::set_terminate([]() DOCTEST_NOEXCEPT \{\par
7899         reportFatal({\cf22 "Terminate handler called"});\par
7900         {\cf19 if} (isDebuggerActive() && !g_cs->no_breaks)\par
7901             DOCTEST_BREAK_INTO_DEBUGGER();\par
7902         std::exit(EXIT_FAILURE); {\cf20 // explicitly exit - otherwise the SIGABRT handler may be called as well}\par
7903     \});\par
7904 \par
7905     {\cf20 // SIGABRT is raised when:}\par
7906     {\cf20 // - std::terminate is called FROM A DIFFERENT THREAD}\par
7907     {\cf20 // - an exception is thrown from a destructor FROM A DIFFERENT THREAD}\par
7908     {\cf20 // - an uncaught exception is thrown FROM A DIFFERENT THREAD}\par
7909     prev_sigabrt_handler = std::signal(SIGABRT, []({\cf18 int} signal) DOCTEST_NOEXCEPT \{\par
7910         {\cf19 if} (signal == SIGABRT) \{\par
7911             reportFatal({\cf22 "SIGABRT - Abort (abnormal termination) signal"});\par
7912             {\cf19 if} (isDebuggerActive() && !g_cs->no_breaks)\par
7913                 DOCTEST_BREAK_INTO_DEBUGGER();\par
7914             std::exit(EXIT_FAILURE);\par
7915         \}\par
7916     \});\par
7917 \par
7918     {\cf20 // The following settings are taken from google test, and more}\par
7919     {\cf20 // specifically from UnitTest::Run() inside of gtest.cc}\par
7920 \par
7921     {\cf20 // the user does not want to see pop-up dialogs about crashes}\par
7922     prev_error_mode_1 = SetErrorMode(\par
7923         SEM_FAILCRITICALERRORS | SEM_NOALIGNMENTFAULTEXCEPT | SEM_NOGPFAULTERRORBOX | SEM_NOOPENFILEERRORBOX\par
7924     );\par
7925     {\cf20 // This forces the abort message to go to stderr in all circumstances.}\par
7926     prev_error_mode_2 = _set_error_mode(_OUT_TO_STDERR);\par
7927     {\cf20 // In the debug version, Visual Studio pops up a separate dialog}\par
7928     {\cf20 // offering a choice to debug the aborted program - we want to disable that.}\par
7929     prev_abort_behavior = _set_abort_behavior(0x0, _WRITE_ABORT_MSG | _CALL_REPORTFAULT);\par
7930     {\cf20 // In debug mode, the Windows CRT can crash with an assertion over invalid}\par
7931     {\cf20 // input (e.g. passing an invalid file descriptor). The default handling}\par
7932     {\cf20 // for these assertions is to pop up a dialog and wait for user input.}\par
7933     {\cf20 // Instead ask the CRT to dump such assertions to stderr non-interactively.}\par
7934     prev_report_mode = _CrtSetReportMode(_CRT_ASSERT, _CRTDBG_MODE_FILE | _CRTDBG_MODE_DEBUG);\par
7935     prev_report_file = _CrtSetReportFile(_CRT_ASSERT, _CRTDBG_FILE_STDERR);\par
7936 \}\par
7937 \par
7938 {\cf18 void} FatalConditionHandler::reset() \{\par
7939     {\cf19 if} (isSet) \{\par
7940         {\cf20 // Unregister handler and restore the old guarantee}\par
7941         SetUnhandledExceptionFilter(previousTop);\par
7942         SetThreadStackGuarantee(&guaranteeSize);\par
7943         std::set_terminate(original_terminate_handler);\par
7944         std::signal(SIGABRT, prev_sigabrt_handler);\par
7945         SetErrorMode(prev_error_mode_1);\par
7946         _set_error_mode(prev_error_mode_2);\par
7947         _set_abort_behavior(prev_abort_behavior, _WRITE_ABORT_MSG | _CALL_REPORTFAULT);\par
7948         {\cf17 static_cast<}{\cf18 void}{\cf17 >}(_CrtSetReportMode(_CRT_ASSERT, prev_report_mode));\par
7949         {\cf17 static_cast<}{\cf18 void}{\cf17 >}(_CrtSetReportFile(_CRT_ASSERT, prev_report_file));\par
7950         isSet = {\cf17 false};\par
7951     \}\par
7952 \}\par
