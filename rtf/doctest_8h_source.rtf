7125 {\cf18 void} ConsoleReporter::test_run_end({\cf17 const} TestRunStats &p) \{\par
7126     {\cf19 if} (opt.minimal && p.numTestCasesFailed == 0)\par
7127         {\cf19 return};\par
7128 \par
7129     separator_to_stream();\par
7130     s << std::dec;\par
7131 \par
7132     {\cf17 auto} totwidth = {\cf17 static_cast<}{\cf18 int}{\cf17 >}(std::ceil(\par
7133         log10({\cf17 static_cast<}{\cf18 double}{\cf17 >}(std::max(p.numTestCasesPassingFilters, {\cf17 static_cast<}{\cf18 unsigned}{\cf17 >}(p.numAsserts))) + 1)\par
7134     ));\par
7135     {\cf17 auto} passwidth = {\cf17 static_cast<}{\cf18 int}{\cf17 >}(std::ceil(log10(\par
7136         {\cf17 static_cast<}{\cf18 double}{\cf17 >}(std::max(\par
7137             p.numTestCasesPassingFilters - p.numTestCasesFailed,\par
7138             {\cf17 static_cast<}{\cf18 unsigned}{\cf17 >}(p.numAsserts - p.numAssertsFailed)\par
7139         )) +\par
7140         1\par
7141     )));\par
7142     {\cf17 auto} failwidth = {\cf17 static_cast<}{\cf18 int}{\cf17 >}(std::ceil(\par
7143         log10({\cf17 static_cast<}{\cf18 double}{\cf17 >}(std::max(p.numTestCasesFailed, {\cf17 static_cast<}{\cf18 unsigned}{\cf17 >}(p.numAssertsFailed))) + 1)\par
7144     ));\par
7145     {\cf17 const} {\cf18 bool} anythingFailed = p.numTestCasesFailed > 0 || p.numAssertsFailed > 0;\par
7146     s << Color::Cyan << {\cf22 "[doctest] "} << Color::None << {\cf22 "test cases: "} << std::setw(totwidth)\par
7147       << p.numTestCasesPassingFilters << {\cf22 " | "}\par
7148       << ((p.numTestCasesPassingFilters == 0 || anythingFailed) ? Color::None : Color::Green) << std::setw(passwidth)\par
7149       << p.numTestCasesPassingFilters - p.numTestCasesFailed << {\cf22 " passed"} << Color::None << {\cf22 " | "}\par
7150       << (p.numTestCasesFailed > 0 ? Color::Red : Color::None) << std::setw(failwidth) << p.numTestCasesFailed\par
7151       << {\cf22 " failed"} << Color::None << {\cf22 " |"};\par
7152     {\cf19 if} (opt.no_skipped_summary == {\cf17 false}) \{\par
7153         {\cf17 const} {\cf18 unsigned} {\cf18 int} numSkipped = p.numTestCases - p.numTestCasesPassingFilters;\par
7154         s << {\cf22 " "} << (numSkipped == 0 ? Color::None : Color::Yellow) << numSkipped << {\cf22 " skipped"} << Color::None;\par
7155     \}\par
7156     s << {\cf22 "\\n"};\par
7157     s << Color::Cyan << {\cf22 "[doctest] "} << Color::None << {\cf22 "assertions: "} << std::setw(totwidth) << p.numAsserts << {\cf22 " | "}\par
7158       << ((p.numAsserts == 0 || anythingFailed) ? Color::None : Color::Green) << std::setw(passwidth)\par
7159       << (p.numAsserts - p.numAssertsFailed) << {\cf22 " passed"} << Color::None << {\cf22 " | "}\par
7160       << (p.numAssertsFailed > 0 ? Color::Red : Color::None) << std::setw(failwidth) << p.numAssertsFailed << {\cf22 " failed"}\par
7161       << Color::None << {\cf22 " |\\n"};\par
7162     s << Color::Cyan << {\cf22 "[doctest] "} << Color::None\par
7163       << {\cf22 "Status: "} << (p.numTestCasesFailed > 0 ? Color::Red : Color::Green)\par
7164       << ((p.numTestCasesFailed > 0) ? {\cf22 "FAILURE!"} : {\cf22 "SUCCESS!"}) << Color::None << std::endl;\par
7165 \}\par
