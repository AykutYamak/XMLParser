2650 {\cf21 #define DOCTEST_ASSERT_OUT_OF_TESTS(decomp)                                                                            \\}\par
2651 {\cf21     do \{ }{\cf20 /* NOLINT(cppcoreguidelines-avoid-do-while) */}{\cf21                                                                 \\}\par
2652 {\cf21         if (!is_running_in_test) \{                                                                                     \\}\par
2653 {\cf21             if (failed) \{                                                                                              \\}\par
2654 {\cf21                 ResultBuilder rb(at, file, line, expr);                                                                \\}\par
2655 {\cf21                 rb.m_failed = failed;                                                                                  \\}\par
2656 {\cf21                 rb.m_decomp = decomp;                                                                                  \\}\par
2657 {\cf21                 failed_out_of_a_testing_context(rb);                                                                   \\}\par
2658 {\cf21                 if (isDebuggerActive() && !getContextOptions()->no_breaks)                                             \\}\par
2659 {\cf21                     DOCTEST_BREAK_INTO_DEBUGGER();                                                                     \\}\par
2660 {\cf21                 if (checkIfShouldThrow(at))                                                                            \\}\par
2661 {\cf21                     throwException();                                                                                  \\}\par
2662 {\cf21             \}                                                                                                          \\}\par
2663 {\cf21             return !failed;                                                                                            \\}\par
2664 {\cf21         \}                                                                                                              \\}\par
2665 {\cf21     \} while (false)}\par
2666 \par
2667 {\cf21 #define DOCTEST_ASSERT_IN_TESTS(decomp)                                                                                \\}\par
2668 {\cf21     ResultBuilder rb(at, file, line, expr);                                                                            \\}\par
2669 {\cf21     rb.m_failed = failed;                                                                                              \\}\par
2670 {\cf21     if (rb.m_failed || getContextOptions()->success)                                                                   \\}\par
2671 {\cf21         rb.m_decomp = decomp;                                                                                          \\}\par
2672 {\cf21     if (rb.log())                                                                                                      \\}\par
2673 {\cf21         DOCTEST_BREAK_INTO_DEBUGGER();                                                                                 \\}\par
2674 {\cf21     if (rb.m_failed && checkIfShouldThrow(at))                                                                         \\}\par
2675 {\cf21     throwException()}\par
