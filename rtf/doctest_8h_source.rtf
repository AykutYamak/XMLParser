5604 {\cf20 // parses an int/bool option from the command line}\par
5605 {\cf18 bool} parseIntOption({\cf18 int} argc, {\cf17 const} {\cf18 char} *{\cf17 const} *argv, {\cf17 const} {\cf18 char} *pattern, optionType type, {\cf18 int} &res) \{\par
5606     String parsedValue;\par
5607     {\cf19 if} (!parseOption(argc, argv, pattern, &parsedValue))\par
5608         {\cf19 return} {\cf17 false};\par
5609 \par
5610     {\cf19 if} (type) \{\par
5611         {\cf20 // integer}\par
5612         {\cf20 // TODO: change this to use std::stoi or something else! currently it uses undefined}\par
5613         {\cf20 // behavior - assumes '0' on failed parse...}\par
5614         {\cf20 // NOLINTNEXTLINE(bugprone-unchecked-string-to-number-conversion, cert-err34-c)}\par
5615         {\cf17 const} {\cf18 int} theInt = std::atoi(parsedValue.c_str());\par
5616         {\cf19 if} (theInt != 0) \{\par
5617             res = theInt;\par
5618             {\cf19 return} {\cf17 true};\par
5619         \}\par
5620     \} {\cf19 else} \{\par
5621         {\cf20 // boolean}\par
5622         {\cf17 const} {\cf18 char} positive[][5] = \{{\cf22 "1"}, {\cf22 "true"}, {\cf22 "on"}, {\cf22 "yes"}\};  {\cf20 // 5 - strlen("true") + 1}\par
5623         {\cf17 const} {\cf18 char} negative[][6] = \{{\cf22 "0"}, {\cf22 "false"}, {\cf22 "off"}, {\cf22 "no"}\}; {\cf20 // 6 - strlen("false") + 1}\par
5624 \par
5625         {\cf20 // if the value matches any of the positive/negative possibilities}\par
5626         {\cf19 for} ({\cf18 unsigned} i = 0; i < 4; i++) \{\par
5627             {\cf19 if} (parsedValue.compare(positive[i], {\cf17 true}) == 0) \{\par
5628                 res = 1;\par
5629                 {\cf19 return} {\cf17 true};\par
5630             \}\par
5631             {\cf19 if} (parsedValue.compare(negative[i], {\cf17 true}) == 0) \{\par
5632                 res = 0;\par
5633                 {\cf19 return} {\cf17 true};\par
5634             \}\par
5635         \}\par
5636     \}\par
5637     {\cf19 return} {\cf17 false};\par
5638 \}\par
5639 \par
5640 \} {\cf20 // namespace detail}\par
