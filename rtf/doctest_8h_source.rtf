5557 {\cf20 // parses a comma separated list of words after a pattern in one of the arguments in argv}\par
5558 {\cf18 bool} parseCommaSepArgs({\cf18 int} argc, {\cf17 const} {\cf18 char} *{\cf17 const} *argv, {\cf17 const} {\cf18 char} *pattern, std::vector<String> &res) \{\par
5559     String filtersString;\par
5560     {\cf19 if} (parseOption(argc, argv, pattern, &filtersString)) \{\par
5561         {\cf20 // tokenize with "," as a separator, unless escaped with backslash}\par
5562         std::ostringstream s;\par
5563         {\cf17 auto} flush = [&s, &res]() \{\par
5564             {\cf17 auto} {\cf18 string} = s.str();\par
5565             {\cf19 if} (!{\cf18 string}.empty()) \{\par
5566                 res.emplace_back({\cf18 string}.c_str());\par
5567             \}\par
5568             s.str({\cf22 ""});\par
5569         \};\par
5570 \par
5571         {\cf18 bool} seenBackslash = {\cf17 false};\par
5572         {\cf17 const} {\cf18 char} *current = filtersString.c_str();\par
5573         {\cf17 const} {\cf18 char} *end = current + strlen(current);\par
5574         {\cf19 while} (current != end) \{\par
5575             {\cf17 const} {\cf18 char} character = *current++;\par
5576             {\cf19 if} (seenBackslash) \{\par
5577                 seenBackslash = {\cf17 false};\par
5578                 {\cf19 if} (character == {\cf23 ','} || character == {\cf23 '\\\\'}) \{\par
5579                     s.put(character);\par
5580                     {\cf19 continue};\par
5581                 \}\par
5582                 s.put({\cf23 '\\\\'});\par
5583             \}\par
5584             {\cf19 if} (character == {\cf23 '\\\\'}) \{\par
5585                 seenBackslash = {\cf17 true};\par
5586             \} {\cf19 else} {\cf19 if} (character == {\cf23 ','}) \{\par
5587                 flush();\par
5588             \} {\cf19 else} \{\par
5589                 s.put(character);\par
5590             \}\par
5591         \}\par
5592 \par
5593         {\cf19 if} (seenBackslash) \{\par
5594             s.put({\cf23 '\\\\'});\par
5595         \}\par
5596         flush();\par
5597         {\cf19 return} {\cf17 true};\par
5598     \}\par
5599     {\cf19 return} {\cf17 false};\par
5600 \}\par
