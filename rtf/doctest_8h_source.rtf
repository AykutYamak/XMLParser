7180 {\cf18 void} ConsoleReporter::test_case_end({\cf17 const} CurrentTestCaseStats &st) \{\par
7181     DOCTEST_LOCK_MUTEX(mutex)\par
7182     {\cf19 if} (tc->m_no_output)\par
7183         {\cf19 return};\par
7184 \par
7185     {\cf20 // log the preamble of the test case only if there is something}\par
7186     {\cf20 // else to print - something other than that an assert has failed}\par
7187     {\cf19 if} (opt.duration ||\par
7188         (st.failure_flags && st.failure_flags != {\cf17 static_cast<}{\cf18 int}{\cf17 >}(TestCaseFailureReason::AssertFailure)))\par
7189         logTestStart();\par
7190 \par
7191     {\cf19 if} (opt.duration)\par
7192         s << Color::None << std::setprecision(6) << std::fixed << st.seconds << {\cf22 " s: "} << tc->m_name << {\cf22 "\\n"};\par
7193 \par
7194     {\cf19 if} (st.failure_flags & TestCaseFailureReason::Timeout)\par
7195         s << Color::Red << {\cf22 "Test case exceeded time limit of "} << std::setprecision(6) << std::fixed << tc->m_timeout\par
7196           << {\cf22 "!\\n"};\par
7197 \par
7198     {\cf19 if} (st.failure_flags & TestCaseFailureReason::ShouldHaveFailedButDidnt) \{\par
7199         s << Color::Red << {\cf22 "Should have failed but didn't! Marking it as failed!\\n"};\par
7200     \} {\cf19 else} {\cf19 if} (st.failure_flags & TestCaseFailureReason::ShouldHaveFailedAndDid) \{\par
7201         s << Color::Yellow << {\cf22 "Failed as expected so marking it as not failed\\n"};\par
7202     \} {\cf19 else} {\cf19 if} (st.failure_flags & TestCaseFailureReason::CouldHaveFailedAndDid) \{\par
7203         s << Color::Yellow << {\cf22 "Allowed to fail so marking it as not failed\\n"};\par
7204     \} {\cf19 else} {\cf19 if} (st.failure_flags & TestCaseFailureReason::DidntFailExactlyNumTimes) \{\par
7205         s << Color::Red << {\cf22 "Didn't fail exactly "} << tc->m_expected_failures << {\cf22 " times so marking it as failed!\\n"};\par
7206     \} {\cf19 else} {\cf19 if} (st.failure_flags & TestCaseFailureReason::FailedExactlyNumTimes) \{\par
7207         s << Color::Yellow << {\cf22 "Failed exactly "} << tc->m_expected_failures\par
7208           << {\cf22 " times as expected so marking it as not failed!\\n"};\par
7209     \}\par
7210     {\cf19 if} (st.failure_flags & TestCaseFailureReason::TooManyFailedAsserts) \{\par
7211         s << Color::Red << {\cf22 "Aborting - too many failed asserts!\\n"};\par
7212     \}\par
7213     s << Color::None;\par
7214 \}\par
