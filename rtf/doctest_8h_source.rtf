5853 \} discardOut;\par
5854 \par
5855 {\cf20 // the main function that does all the filtering and test running}\par
5856 {\cf18 int} Context::run() \{\par
5857     {\cf17 using namespace }detail;\par
5858 \par
5859     {\cf20 // save the old context state in case such was setup - for using asserts out of a testing context}\par
5860     {\cf17 auto} old_cs = g_cs;\par
5861     {\cf20 // this is the current contest}\par
5862     g_cs = p;\par
5863     is_running_in_test = {\cf17 true};\par
5864 \par
5865     g_no_colors = p->no_colors;\par
5866     p->resetRunData();\par
5867 \par
5868     std::fstream fstr;\par
5869     {\cf19 if} (p->cout == {\cf17 nullptr}) \{\par
5870         {\cf19 if} (p->quiet) \{\par
5871             p->cout = &discardOut;\par
5872         \} {\cf19 else} {\cf19 if} (p->out.size()) \{\par
5873             {\cf20 // to a file if specified}\par
5874             fstr.open(p->out.c_str(), std::fstream::out);\par
5875             p->cout = &fstr;\par
5876             {\cf19 if} (!fstr.is_open()) \{\par
5877                 {\cf20 // clang-format off}\par
5878                 std::cerr << Color::Cyan << {\cf22 "[doctest] "} << Color::None << {\cf22 "Could not open "} << p->out << {\cf22 " for writing!"} << std::endl;\par
5879                 std::cerr << Color::Cyan << {\cf22 "[doctest] "} << Color::None << {\cf22 "Defaulting to std::cout instead"} << std::endl;\par
5880                 p->cout = &std::cout;\par
5881                 {\cf20 // clang-format on}\par
5882             \}\par
5883 \par
5884         \} {\cf19 else} \{\par
5885 {\cf21 #ifndef DOCTEST_CONFIG_NO_INCLUDE_IOSTREAM}\par
5886             {\cf20 // stdout by default}\par
5887             p->cout = &std::cout;\par
5888 {\cf21 #else  }{\cf20 // DOCTEST_CONFIG_NO_INCLUDE_IOSTREAM}\par
5889             {\cf19 return} EXIT_FAILURE;\par
5890 {\cf21 #endif }{\cf20 // DOCTEST_CONFIG_NO_INCLUDE_IOSTREAM}\par
5891         \}\par
5892     \}\par
5893 \par
5894     FatalConditionHandler::allocateAltStackMem();\par
5895 \par
5896     {\cf17 auto} cleanup_and_return = [&]() \{\par
5897         FatalConditionHandler::freeAltStackMem();\par
5898 \par
5899         {\cf19 if} (fstr.is_open())\par
5900             fstr.close();\par
5901 \par
5902         {\cf20 // restore context}\par
5903         g_cs = old_cs;\par
5904         is_running_in_test = {\cf17 false};\par
5905 \par
5906         {\cf20 // we have to free the reporters which were allocated when the run started}\par
5907         {\cf19 for} ({\cf17 auto} &curr: p->reporters_currently_used)\par
5908             {\cf17 delete} curr;\par
5909         p->reporters_currently_used.clear();\par
5910 \par
5911         {\cf19 if} (p->numTestCasesFailed && !p->no_exitcode)\par
5912             {\cf19 return} EXIT_FAILURE;\par
5913         {\cf19 return} EXIT_SUCCESS;\par
5914     \};\par
5915 \par
5916     {\cf20 // setup default reporter if none is given through the command line}\par
5917     {\cf19 if} (p->filters[8].empty())\par
5918         p->filters[8].emplace_back({\cf22 "console"});\par
5919 \par
5920     {\cf20 // check to see if any of the registered reporters has been selected}\par
5921     {\cf19 for} ({\cf17 auto} &curr: getReporters()) \{\par
5922         {\cf19 if} (matchesAny(curr.first.second.c_str(), p->filters[8], {\cf17 false}, p->case_sensitive))\par
5923             p->reporters_currently_used.push_back(curr.second(*g_cs));\par
5924     \}\par
5925 \par
5926     {\cf20 // TODO: check if there is nothing in reporters_currently_used}\par
5927 \par
5928     {\cf20 // prepend all listeners}\par
5929     {\cf19 for} ({\cf17 auto} &curr: getListeners())\par
5930         p->reporters_currently_used.insert(p->reporters_currently_used.begin(), curr.second(*g_cs));\par
5931 \par
5932 {\cf21 #ifdef DOCTEST_PLATFORM_WINDOWS}\par
5933     {\cf19 if} (isDebuggerActive() && p->no_debug_output == {\cf17 false})\par
5934         p->reporters_currently_used.push_back({\cf17 new} DebugOutputWindowReporter(*g_cs));\par
5935 {\cf21 #endif }{\cf20 // DOCTEST_PLATFORM_WINDOWS}\par
5936 \par
5937     {\cf20 // handle version, help and no_run}\par
5938     {\cf19 if} (p->no_run || p->version || p->help || p->list_reporters) \{\par
5939         DOCTEST_ITERATE_THROUGH_REPORTERS(report_query, QueryData());\par
5940 \par
5941         {\cf19 return} cleanup_and_return();\par
5942     \}\par
5943 \par
5944     std::vector<const TestCase *> testArray;\par
5945     {\cf19 for} ({\cf17 auto} &curr: getRegisteredTests())\par
5946         testArray.push_back(&curr);\par
5947     p->numTestCases = testArray.size();\par
5948 \par
5949     {\cf20 // sort the collected records}\par
5950     {\cf19 if} (!testArray.empty()) \{\par
5951         {\cf19 if} (p->order_by.compare({\cf22 "file"}, {\cf17 true}) == 0) \{\par
5952             std::sort(testArray.begin(), testArray.end(), fileOrderComparator);\par
5953         \} {\cf19 else} {\cf19 if} (p->order_by.compare({\cf22 "suite"}, {\cf17 true}) == 0) \{\par
5954             std::sort(testArray.begin(), testArray.end(), suiteOrderComparator);\par
5955         \} {\cf19 else} {\cf19 if} (p->order_by.compare({\cf22 "name"}, {\cf17 true}) == 0) \{\par
5956             std::sort(testArray.begin(), testArray.end(), nameOrderComparator);\par
5957         \} {\cf19 else} {\cf19 if} (p->order_by.compare({\cf22 "rand"}, {\cf17 true}) == 0) \{\par
5958             std::srand(p->rand_seed);\par
5959 \par
5960             {\cf20 // random_shuffle implementation}\par
5961             {\cf17 const} {\cf17 auto} first = testArray.data();\par
5962             {\cf19 for} ({\cf18 size_t} i = testArray.size() - 1; i > 0; --i) \{\par
5963                 {\cf20 // NOLINTNEXTLINE(cert-msc30-c, cert-msc50-cpp, concurrency-mt-unsafe, misc-predictable-rand)}\par
5964                 {\cf17 const} {\cf18 int} idxToSwap = {\cf17 static_cast<}{\cf18 int}{\cf17 >}(std::rand() % (i + 1));\par
5965 \par
5966                 {\cf17 const} {\cf17 auto} temp = first[i];\par
5967 \par
5968                 first[i] = first[idxToSwap];\par
5969                 first[idxToSwap] = temp;\par
5970             \}\par
5971         \} {\cf19 else} {\cf19 if} (p->order_by.compare({\cf22 "none"}, {\cf17 true}) == 0) \{\par
5972             {\cf20 // means no sorting - beneficial for death tests which call into the executable}\par
