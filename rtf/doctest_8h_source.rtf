7349 std::string JUnitReporter::JUnitTestCaseData::getCurrentTimestamp() \{\par
7350     {\cf20 // Beware, this is not reentrant because of backward compatibility issues}\par
7351     {\cf20 // Also, UTC only, again because of backward compatibility (%z is C++11)}\par
7352     time_t rawtime\{\};\par
7353     {\cf17 static_cast<}{\cf18 void}{\cf17 >}(std::time(&rawtime));\par
7354     {\cf17 const} {\cf17 auto} timeStampSize = {\cf17 sizeof}({\cf22 "2017-01-16T17:06:45Z"});\par
7355 \par
7356     std::tm timeInfo;\par
7357 {\cf21 #if defined(DOCTEST_PLATFORM_WINDOWS)}\par
7358     gmtime_s(&timeInfo, &rawtime);\par
7359 {\cf21 #elif defined(__STDC_LIB_EXT1__)}\par
7360     gmtime_s(&rawtime, &timeInfo);\par
7361 {\cf21 #else  }{\cf20 // DOCTEST_PLATFORM_WINDOWS}\par
7362     gmtime_r(&rawtime, &timeInfo);\par
7363 {\cf21 #endif }{\cf20 // DOCTEST_PLATFORM_WINDOWS}\par
7364 \par
7365     {\cf18 char} timeStamp[timeStampSize];\par
7366     {\cf17 const} {\cf18 char} *{\cf17 const} fmt = {\cf22 "%Y-%m-%dT%H:%M:%SZ"};\par
7367 \par
7368     {\cf17 static_cast<}{\cf18 void}{\cf17 >}(std::strftime(timeStamp, timeStampSize, fmt, &timeInfo));\par
7369     {\cf19 return} std::string(timeStamp);\par
7370 \}\par
