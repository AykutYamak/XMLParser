7223     file_line_to_stream(tc->m_file.c_str(), {\cf17 static_cast<}{\cf18 int}{\cf17 >}(tc->m_line), {\cf22 " "});\par
7224     successOrFailColoredStringToStream({\cf17 false}, e.is_crash ? assertType::is_require : assertType::is_check);\par
7225     s << Color::Red << (e.is_crash ? {\cf22 "test case CRASHED: "} : {\cf22 "test case THREW exception: "});\par
