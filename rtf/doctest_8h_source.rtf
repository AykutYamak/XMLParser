6928                 s << {\cf22 "  "} << subcasesStack[i].m_name << {\cf22 "\\n"};\par
6929         \}\par
6930     \}\par
6931 \par
6932     s << {\cf22 "\\n"};\par
6933 \par
6934     hasLoggedCurrentTestStart = {\cf17 true};\par
6935 \}\par
