6917     s << Color::None << tc->m_name << {\cf22 "\\n"};\par
6918 \par
6919     {\cf19 for} ({\cf18 size_t} i = 0; i < currentSubcaseLevel; ++i) \{\par
6920         {\cf19 if} (subcasesStack[i].m_name[0] != {\cf23 '\\0'})\par
6921             s << {\cf22 "  "} << subcasesStack[i].m_name << {\cf22 "\\n"};\par
6922     \}\par
6923 \par
6924     {\cf19 if} (currentSubcaseLevel != subcasesStack.size()) \{\par
6925         s << Color::Yellow << {\cf22 "\\nDEEPEST SUBCASE STACK REACHED (DIFFERENT FROM THE CURRENT ONE):\\n"} << Color::None;\par
