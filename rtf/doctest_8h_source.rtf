7436 {\cf21 #endif }{\cf20 // DOCTEST_PLATFORM_WINDOWS}\par
7437 \par
7438     xml.startElement({\cf22 "testsuites"});\par
7439     xml.startElement({\cf22 "testsuite"})\par
7440         .writeAttribute({\cf22 "name"}, binary_name)\par
7441         .writeAttribute({\cf22 "errors"}, testCaseData.totalErrors)\par
7442         .writeAttribute({\cf22 "failures"}, testCaseData.totalFailures)\par
7443         .writeAttribute({\cf22 "tests"}, p.numAsserts);\par
7444     {\cf19 if} (opt.no_time_in_output == {\cf17 false}) \{\par
