7455         {\cf19 if} (opt.no_time_in_output == {\cf17 false})\par
7456             xml.writeAttribute({\cf22 "time"}, testCase.time);\par
7457         {\cf20 // This is not ideal, but it should be enough to mimic gtest's junit output.}\par
7458         xml.writeAttribute({\cf22 "status"}, {\cf22 "run"});\par
7459 \par
7460         {\cf19 for} ({\cf17 const} {\cf17 auto} &failure: testCase.failures) \{\par
7461             xml.scopedElement({\cf22 "failure"})\par
7462                 .writeAttribute({\cf22 "message"}, failure.message)\par
