2677 {\cf17 template} <{\cf18 int} comparison, {\cf17 typename} L, {\cf17 typename} R>\par
2678 DOCTEST_NOINLINE {\cf18 bool} binary_assert(\par
2679     assertType::Enum at,\par
2680     {\cf17 const} {\cf18 char} *file,\par
2681     {\cf18 int} line,\par
2682     {\cf17 const} {\cf18 char} *expr,\par
2683     {\cf17 const} DOCTEST_REF_WRAP(L) lhs,\par
2684     {\cf17 const} DOCTEST_REF_WRAP(R) rhs\par
2685 ) \{\par
2686     {\cf17 const} {\cf18 bool} failed = !RelationalComparator<comparison, L, R>()(lhs, rhs);\par
2687 \par
2688     {\cf20 // ###################################################################################}\par
2689     {\cf20 // IF THE DEBUGGER BREAKS HERE - GO 1 LEVEL UP IN THE CALLSTACK FOR THE FAILING ASSERT}\par
2690     {\cf20 // THIS IS THE EFFECT OF HAVING 'DOCTEST_CONFIG_SUPER_FAST_ASSERTS' DEFINED}\par
2691     {\cf20 // ###################################################################################}\par
2692     DOCTEST_ASSERT_OUT_OF_TESTS(stringifyBinaryExpr(lhs, {\cf22 ", "}, rhs));\par
2693     DOCTEST_ASSERT_IN_TESTS(stringifyBinaryExpr(lhs, {\cf22 ", "}, rhs));\par
2694     {\cf19 return} !failed;\par
2695 \}\par
2696 \par
2697 {\cf17 template} <{\cf17 typename} L>\par
2698 DOCTEST_NOINLINE {\cf18 bool}\par
2699 unary_assert(assertType::Enum at, {\cf17 const} {\cf18 char} *file, {\cf18 int} line, {\cf17 const} {\cf18 char} *expr, {\cf17 const} DOCTEST_REF_WRAP(L) val) \{\par
2700     {\cf18 bool} failed = !val;\par
2701 \par
2702     {\cf19 if} (at & assertType::is_false)\par
2703         failed = !failed;\par
2704 \par
2705     {\cf20 // ###################################################################################}\par
2706     {\cf20 // IF THE DEBUGGER BREAKS HERE - GO 1 LEVEL UP IN THE CALLSTACK FOR THE FAILING ASSERT}\par
2707     {\cf20 // THIS IS THE EFFECT OF HAVING 'DOCTEST_CONFIG_SUPER_FAST_ASSERTS' DEFINED}\par
2708     {\cf20 // ###################################################################################}\par
2709     DOCTEST_ASSERT_OUT_OF_TESTS((DOCTEST_STRINGIFY(val)));\par
2710     DOCTEST_ASSERT_IN_TESTS((DOCTEST_STRINGIFY(val)));\par
2711     {\cf19 return} !failed;\par
2712 \}\par
