7852 LONG CALLBACK FatalConditionHandler::handleException(PEXCEPTION_POINTERS ExceptionInfo) \{\par
7853     {\cf20 // Multiple threads may enter this filter/handler at once. We want the error message to be}\par
7854     {\cf20 // printed on the console just once no matter how many threads have crashed.}\par
7855     DOCTEST_DECLARE_STATIC_MUTEX(mutex)\par
7856     {\cf17 static} {\cf18 bool} execute = {\cf17 true};\par
7857     \{\par
7858         DOCTEST_LOCK_MUTEX(mutex)\par
7859         {\cf19 if} (execute) \{\par
7860             {\cf18 bool} reported = {\cf17 false};\par
7861             {\cf19 for} ({\cf18 size_t} i = 0; i < DOCTEST_COUNTOF(signalDefs); ++i) \{\par
7862                 {\cf19 if} (ExceptionInfo->ExceptionRecord->ExceptionCode == signalDefs[i].id) \{\par
7863                     reportFatal(signalDefs[i].name);\par
7864                     reported = {\cf17 true};\par
7865                     {\cf19 break};\par
7866                 \}\par
7867             \}\par
7868             {\cf19 if} (reported == {\cf17 false})\par
7869                 reportFatal({\cf22 "Unhandled SEH exception caught"});\par
7870             {\cf19 if} (isDebuggerActive() && !g_cs->no_breaks)\par
7871                 DOCTEST_BREAK_INTO_DEBUGGER();\par
7872         \}\par
7873         execute = {\cf17 false};\par
7874     \}\par
7875     std::exit(EXIT_FAILURE);\par
7876 \}\par
