7216 {\cf18 void} ConsoleReporter::test_case_exception({\cf17 const} TestCaseException &e) \{\par
7217     DOCTEST_LOCK_MUTEX(mutex)\par
7218     {\cf19 if} (tc->m_no_output)\par
