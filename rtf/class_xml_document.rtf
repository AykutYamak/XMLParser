\pard\plain {\*\hyphen2\hyphlead2\hyphtrail2\hyphmax0}\nowidctlpar\cf0\hich\af0\langfe2052\dbch\af0\afs24\lang1081\loch\f0\fs24\lang1033{\listtext\pard\plain \hich\af3\dbch\af3\loch\f8 \'01\u9702\tab}\ilvl1\ls1 \li0\ri0\lin0\rin0\fi-360\tx720\li720\ri0\lin720\rin0\fi-360\kerning1\hich\af4\dbch\af5\rtlch \ltrch\loch\fs20
\par}
Тази функция е сърцето на парсъра. Тя чете файла ред по ред и използва структура от данни "стек" (std::vector<XmlElement*> parseStack), за да следи вложеността на таговете и да изгради правилни връзки родител-дете.{
\par
\pard\plain {\*\hyphen2\hyphlead2\hyphtrail2\hyphmax0}\nowidctlpar\cf0\hich\af0\langfe2052\dbch\af0\afs24\lang1081\loch\f0\fs24\lang1033{\listtext\pard\plain \hich\af3\dbch\af3\loch\f8 \'01\u9702\tab}\ilvl1\ls1 \li0\ri0\lin0\rin0\fi-360\tx720\li720\ri0\lin720\rin0\fi-360\kerning1\hich\af4\dbch\af5\rtlch \ltrch\loch\fs20
{\b Алгоритъм на работа:} \par}
{
\par
\pard\plain \s141\fi-360\li720\widctlpar\fs20\cgrid 
1.\tab {\b Отварящи тагове ({\f2 <tag>} ):}  Създава нов {\b XmlElement}, регистрира го в ID речника (генерирайки ID, ако липсва) и го добавя като дете на елемента, който в момента е на върха на стека. След това новият елемент се поставя (push) в стека.\par
\pard\plain \s141\fi-360\li720\widctlpar\fs20\cgrid 
2.\tab **Затварящи тагове ({\f2 </tag>} ):** Премахва (pop) най-горния елемент от стека, тъй като неговият обхват е приключил и всички негови деца са вече добавени.\par
\pard\plain \s141\fi-360\li720\widctlpar\fs20\cgrid 
3.\tab {\b Текстови възли:}  Ако прочетеният ред не е таг, той се третира като текст ({\b XmlText}) и се добавя директно към елемента на върха на стека.\par}
{
\par
\pard\plain {\*\hyphen2\hyphlead2\hyphtrail2\hyphmax0}\nowidctlpar\cf0\hich\af0\langfe2052\dbch\af0\afs24\lang1081\loch\f0\fs24\lang1033{\listtext\pard\plain \hich\af3\dbch\af3\loch\f8 \'01\u9702\tab}\ilvl1\ls1 \li0\ri0\lin0\rin0\fi-360\tx720\li720\ri0\lin720\rin0\fi-360\kerning1\hich\af4\dbch\af5\rtlch \ltrch\loch\fs20
{\b Специални случаи, които парсърът обработва успешно:} \par
\pard\plain {\*\hyphen2\hyphlead2\hyphtrail2\hyphmax0}\nowidctlpar\cf0\hich\af0\langfe2052\dbch\af0\afs24\lang1081\loch\f0\fs24\lang1033{\listtext\pard\plain \hich\af3\dbch\af3\loch\f8 \'01\u9702\tab}\ilvl1\ls1 \li0\ri0\lin0\rin0\fi-360\tx720\li720\ri0\lin720\rin0\fi-360\kerning1\hich\af4\dbch\af5\rtlch \ltrch\loch\fs20
{\b Inline тагове:}  Разпознава тагове с текст на един ред (напр. {\f2 <name>John</name>} ), парсва ги и ги добавя в дървото, без да ги задържа в стека.\par
\pard\plain {\*\hyphen2\hyphlead2\hyphtrail2\hyphmax0}\nowidctlpar\cf0\hich\af0\langfe2052\dbch\af0\afs24\lang1081\loch\f0\fs24\lang1033{\listtext\pard\plain \hich\af3\dbch\af3\loch\f8 \'01\u9702\tab}\ilvl1\ls1 \li0\ri0\lin0\rin0\fi-360\tx720\li720\ri0\lin720\rin0\fi-360\kerning1\hich\af4\dbch\af5\rtlch \ltrch\loch\fs20
{\b Самозатварящи се тагове:}  Обработва тагове завършващи на {\f2 />}  (напр. {\f2 <br/>} ), като ги инстанцира, но "прескача" добавянето им в стека.\par
\pard\plain {\*\hyphen2\hyphlead2\hyphtrail2\hyphmax0}\nowidctlpar\cf0\hich\af0\langfe2052\dbch\af0\afs24\lang1081\loch\f0\fs24\lang1033{\listtext\pard\plain \hich\af3\dbch\af3\loch\f8 \'01\u9702\tab}\ilvl1\ls1 \li0\ri0\lin0\rin0\fi-360\tx720\li720\ri0\lin720\rin0\fi-360\kerning1\hich\af4\dbch\af5\rtlch \ltrch\loch\fs20
{\b Множество Root елементи:}  XML стандартът изисква само 1 корен. Ако парсърът открие множество елементи на нулево ниво, той автоматично генерира невидим {\f2 <document_wrapper>} , който да ги обедини и да спаси структурата от презаписване.\par
